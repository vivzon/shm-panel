#!/bin/bash

# ==============================================================================
# SHM PANEL - BACKEND ENGINE (shm-manage)
# ==============================================================================
# This script handles all privileged operations for WHM and CPanel.
# It is called via sudo from the PHP frontend.
# ==============================================================================

source /etc/shm/config.sh

# Fallback Configuration
if [ -z "$ADMIN_EMAIL" ]; then
    ADMIN_EMAIL="admin@$(hostname -f)"
fi

# Helper: Log Action
log_action() {    echo "[$(date)] $1" >> /var/log/shm-manage.log
}

# Helper: Safe PHP Reload (Prevents 502)
safe_reload_php() {
    # Sleep 5s to allow PHP script to finish request and close connection
    nohup bash -c "sleep 5; systemctl reload php8.2-fpm" >/dev/null 2>&1 &
}

case "$1" in

    # --------------------------------------------------------------------------
    # ACCOUNT MANAGEMENT
    # --------------------------------------------------------------------------
    create-account)
        # $2: user, $3: domain, $4: email, $5: pass
        USER=$2; DOM=$3; EMAIL=$4; PASS=$5
        
        if id "$USER" &>/dev/null; then echo "User exists"; exit 1; fi
        
        # 1. System User
        useradd -m -d /var/www/clients/$USER -s /bin/bash $USER
        mkdir -p /var/www/clients/$USER/{public_html,logs,tmp,mail}
        chown -R $USER:$USER /var/www/clients/$USER
        
        # PERMISSION FIX: Allow www-data (File Manager) to write
        # Add www-data to user group
        usermod -a -G $USER www-data
        # Set permissions so group can write
        chmod -R 775 /var/www/clients/$USER
        
        # 2. PHP-FPM Pool
        cat > /etc/php/8.2/fpm/pool.d/$USER.conf << PHP
[$USER]
user = $USER
group = $USER
listen = /run/php/php8.2-fpm-$USER.sock
listen.owner = www-data
listen.group = www-data
pm = ondemand
pm.max_children = 5
php_admin_value[open_basedir] = /var/www/clients/$USER:/tmp
php_admin_value[upload_max_filesize] = 1024M
php_admin_value[post_max_size] = 1024M
PHP
PHP

        # 3. Nginx VHost
        cat > /etc/nginx/sites-available/$DOM << NGINX
server {
    listen 80;
    server_name $DOM www.$DOM;
    root /var/www/clients/$USER/public_html;
    index index.php index.html;
    
    client_max_body_size 512M;

    access_log /var/www/clients/$USER/logs/access.log;
    error_log /var/www/clients/$USER/logs/error.log;

    location / {
        try_files \$uri \$uri/ /index.php?\$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm-$USER.sock;
    }
}
NGINX
        ln -s /etc/nginx/sites-available/$DOM /etc/nginx/sites-enabled/
        systemctl reload nginx

        # 4. Default Index
        echo "<h1>Welcome to $DOM</h1><p>Hosted by SHM Panel</p>" > /var/www/clients/$USER/public_html/index.html
        chown $USER:$USER /var/www/clients/$USER/public_html/index.html

        # 5. Sync DNS (Generate Zone File)
        DOM_ID=$(mysql -N -s -e "SELECT id FROM domains WHERE domain='$DOM'" $DB_NAME)
        if [ ! -z "$DOM_ID" ]; then
             $0 dns-tool sync $DOM_ID
        fi

        log_action "Created account: $USER ($DOM)"
        
        # Trigger Reload at the END
        safe_reload_php
        ;;

    delete-account)
        # $2: user
        USER=$2
        
        # Find domain to remove vhost
        DOM=$(mysql -N -s -e "SELECT domain FROM domains d JOIN clients c ON d.client_id=c.id WHERE c.username='$USER'" $DB_NAME)
        
        if [ ! -z "$DOM" ]; then
            rm -f /etc/nginx/sites-enabled/$DOM
            rm -f /etc/nginx/sites-available/$DOM
        fi
        
        rm -f /etc/php/8.2/fpm/pool.d/$USER.conf
        
        # Kill user processes
        pkill -u $USER
        
        # Remove User & Files
        userdel -r $USER
        
        systemctl reload nginx
        systemctl reload nginx
        safe_reload_php
        
        log_action "Deleted account: $USER"
        ;;

    add-domain)
        # $2: user, $3: domain
        USER=$2; DOM=$3
        
        DOCROOT="/var/www/clients/$USER/domains/$DOM/public_html"
        mkdir -p $DOCROOT
        echo "<h1>$DOM</h1><p>Additional Domain</p>" > $DOCROOT/index.html
        chown -R $USER:$USER /var/www/clients/$USER/domains
        # FORCE 775 for Group Write (www-data)
        chmod -R 775 /var/www/clients/$USER/domains/$DOM
        
        cat > /etc/nginx/sites-available/$DOM << NGINX
server {
    listen 80;
    server_name $DOM www.$DOM;
    root $DOCROOT;
    index index.php index.html;

    client_max_body_size 1024M;

    access_log /var/www/clients/$USER/logs/access.log;
    error_log /var/www/clients/$USER/logs/error.log;

    location / {
        try_files \$uri \$uri/ /index.php?\$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm-$USER.sock;
    }
}
NGINX
        ln -s /etc/nginx/sites-available/$DOM /etc/nginx/sites-enabled/
        systemctl reload nginx
        
        log_action "Added Domain: $DOM for $USER"
        ;;

    delete-domain)
        # $2: user, $3: domain
        USER=$2; DOM=$3
        
        # Remove Nginx Config
        rm -f /etc/nginx/sites-enabled/$DOM
        rm -f /etc/nginx/sites-available/$DOM
        
        # Remove Files (Remove the specific domain directory)
        DOCROOT="/var/www/clients/$USER/domains/$DOM"
        if [ -d "$DOCROOT" ]; then
            rm -rf $DOCROOT
        fi
        
        systemctl reload nginx
        log_action "Deleted Domain: $DOM for $USER"
        ;;

    suspend-account)
        # $2: user
        USER=$2
        # Find domain
        DOM=$(mysql -N -s -e "SELECT domain FROM domains d JOIN clients c ON d.client_id=c.id WHERE c.username='$USER'" $DB_NAME)
        
        if [ ! -z "$DOM" ]; then
            rm -f /etc/nginx/sites-enabled/$DOM
        fi
        
        # Disable PHP Pool
        if [ -f "/etc/php/8.2/fpm/pool.d/$USER.conf" ]; then
            mv /etc/php/8.2/fpm/pool.d/$USER.conf /etc/php/8.2/fpm/pool.d/$USER.conf.disabled
        fi
        
        # Kill processes
        pkill -u $USER
        
        systemctl reload nginx
        nohup bash -c "sleep 1; systemctl reload php8.2-fpm" >/dev/null 2>&1 &
        
        log_action "Suspended account: $USER"
        ;;

    unsuspend-account)
        # $2: user
        USER=$2
        # Find domain
        DOM=$(mysql -N -s -e "SELECT domain FROM domains d JOIN clients c ON d.client_id=c.id WHERE c.username='$USER'" $DB_NAME)
        
        if [ ! -z "$DOM" ]; then
            ln -sf /etc/nginx/sites-available/$DOM /etc/nginx/sites-enabled/
        fi
        
        # Enable PHP Pool
        if [ -f "/etc/php/8.2/fpm/pool.d/$USER.conf.disabled" ]; then
            mv /etc/php/8.2/fpm/pool.d/$USER.conf.disabled /etc/php/8.2/fpm/pool.d/$USER.conf
        fi
        
        systemctl reload nginx
        nohup bash -c "sleep 1; systemctl reload php8.2-fpm" >/dev/null 2>&1 &
        
        log_action "Unsuspended account: $USER"
        ;;

    reset-account)
        # $2: user
        USER=$2
        
        # 1. Get Client ID
        CID=$(mysql -N -s -e "SELECT id FROM clients WHERE username='$USER'" $DB_NAME)
        
        # 2. Drop Databases
        mysql -N -s -e "SELECT db_name FROM client_databases WHERE client_id=$CID" $DB_NAME | while read DB; do
            mysql -e "DROP DATABASE IF EXISTS $DB;"
            log_action "Dropped DB (Reset): $DB"
        done
        
        # 3. Wipe Web Content
        DOCROOT="/var/www/clients/$USER/public_html"
        if [ -d "$DOCROOT" ]; then
            rm -rf $DOCROOT/*
            # Restore Default
            echo "<h1>Welcome to $USER</h1><p>Account has been reset.</p>" > $DOCROOT/index.html
            chown $USER:$USER $DOCROOT/index.html
        fi
        
        log_action "Reset Account: $USER"
        ;;

    # --------------------------------------------------------------------------
    # PERMISSION FIX TOOL
    # --------------------------------------------------------------------------
    fix-permissions)
        # $2: user
        USER=$2
        HOME_DIR="/var/www/clients/$USER"
        
        if [ -d "$HOME_DIR" ]; then
            # 1. Reset Ownership
            chown -R $USER:$USER $HOME_DIR
            
            # 2. Reset Mode (775 for folders, 664 for files)
            # Find directories and set to 775
            find $HOME_DIR -type d -exec chmod 775 {} \;
            # Find files and set to 664
            find $HOME_DIR -type f -exec chmod 664 {} \;
            
            # 3. Ensure www-data is in group (Redundant but safe)
            usermod -a -G $USER www-data
            
            log_action "Fixed Permissions for: $USER"
        fi
        ;;

    # --------------------------------------------------------------------------
    # MYSQL TOOL
    # --------------------------------------------------------------------------
    mysql-tool)
        SUB=$2
        if [ "$SUB" == "create-db" ]; then
            # $3: db_name
            mysql -e "CREATE DATABASE IF NOT EXISTS \`$3\`;" || exit 1
            log_action "Created DB: $3"
        elif [ "$SUB" == "create-user" ]; then
            # $3: db_user, $4: db_pass, $5: target_db
            
            # Simple SQL Escaping (Single quotes and Backslashes)
            PASS="${4//\\/\\\\}"
            PASS="${PASS//\'/\'\'}"

            # Create User
            mysql -e "CREATE USER '$3'@'localhost' IDENTIFIED BY '$PASS';" || { echo "Error: Create User Failed"; exit 1; }
            
            # Grant Privileges (Escape DB name with backticks)
            mysql -e "GRANT ALL PRIVILEGES ON \`$5\`.* TO '$3'@'localhost';" || { echo "Error: Grant Failed"; exit 1; }
            
            mysql -e "FLUSH PRIVILEGES;"
            log_action "Created DB User: $3 for $5"
        elif [ "$SUB" == "delete-db" ]; then
            # $3: db_name
            mysql -e "DROP DATABASE IF EXISTS \`$3\`;" || exit 1
            log_action "Dropped DB: $3"
        elif [ "$SUB" == "reset-pass" ]; then
            # $3: db_user, $4: new_pass
            
            PASS="${4//\\/\\\\}"
            PASS="${PASS//\'/\'\'}"

            mysql -e "ALTER USER '$3'@'localhost' IDENTIFIED BY '$PASS';" || { echo "Error: Password Reset Failed"; exit 1; }
            mysql -e "FLUSH PRIVILEGES;"
            log_action "Reset Pass DB User: $3"
            
        elif [ "$SUB" == "delete-user" ]; then
            # $3: db_user
            mysql -e "DROP USER IF EXISTS '$3'@'localhost';" || echo "User drop failed or not found"
            log_action "Deleted DB User: $3"
        fi
        ;;

    # --------------------------------------------------------------------------
    # DNS TOOL
    # --------------------------------------------------------------------------
    dns-tool)
        SUB=$2
        if [ "$SUB" == "sync" ]; then
            # $3: domain_id
            DOM_INFO=$(mysql -N -s -e "SELECT domain FROM domains WHERE id=$3" $DB_NAME)
            
            # Start Zone File
            ZONE_FILE="/etc/bind/zones/db.$DOM_INFO"
            cat > $ZONE_FILE <<ZONE
\$TTL 86400
@ IN SOA ns1.$MAIN_DOMAIN. $ADMIN_EMAIL. ( $(date +%Y%m%d)01 3600 900 604800 86400 )
@ IN NS ns1.$MAIN_DOMAIN.
@ IN NS ns2.$MAIN_DOMAIN.
@ IN A $(hostname -I | awk '{print $1}')
www IN CNAME @
ZONE

            # Glue Records for Nameservers (Only for Main Domain)
            if [ "$DOM_INFO" == "$MAIN_DOMAIN" ]; then
                # Use public IP if possible, fallback to local
                IP=$(hostname -I | awk '{print $1}')
                echo "ns1 IN A $IP" >> $ZONE_FILE
                echo "ns2 IN A $IP" >> $ZONE_FILE
                log_action "Added Nameserver Glue Records for $DOM_INFO"
            fi
            
            # Append Records from DB
            mysql -N -B -e "SELECT host, type, value FROM dns_records WHERE domain_id=$3" $DB_NAME | while IFS=$'\t' read -r host type value; do
                if [ "$type" == "MX" ]; then
                    echo "$host IN MX 10 $value" >> $ZONE_FILE
                elif [ "$type" == "TXT" ]; then
                    # Escape quotes and wrap in quotes
                    clean_val="${value//\"/\\\"}"
                    echo "$host IN TXT \"$clean_val\"" >> $ZONE_FILE
                else
                    echo "$host IN $type $value" >> $ZONE_FILE
                fi
            done
            
            # Ensure Bind knows about it (simplistic check)
            if ! grep -q "zone \"$DOM_INFO\"" /etc/bind/named.conf.local; then
                echo "zone \"$DOM_INFO\" { type master; file \"$ZONE_FILE\"; };" >> /etc/bind/named.conf.local
            fi
            
            systemctl reload bind9
            log_action "Synced DNS for $DOM_INFO"
        fi
        ;;

    # --------------------------------------------------------------------------
    # VHOST TOOL (PHP Version & SSL Switcher)
    # --------------------------------------------------------------------------
    vhost-tool)
        SUB=$2
        if [ "$SUB" == "sync" ]; then
            # $3: domain_id
            read DOM USER PHP_VER SSL <<< $(mysql -N -s -e "SELECT d.domain, c.username, d.php_version, d.ssl_active FROM domains d JOIN clients c ON d.client_id=c.id WHERE d.id=$3" $DB_NAME)
            
            VHOST="/etc/nginx/sites-available/$DOM"
            
            # PHP Sock
            SOCK="php$PHP_VER-fpm-$USER.sock"
            
            # SSL Paths
            CERT="/etc/letsencrypt/live/$DOM/fullchain.pem"
            KEY="/etc/letsencrypt/live/$DOM/privkey.pem"
            
            # Check if SSL is requested and Certs exist
            if [ "$SSL" == "1" ] && [ -f "$CERT" ]; then
                # Generate SSL VHost directly
                cat > $VHOST <<CONF
server {
    listen 80;
    server_name $DOM www.$DOM;
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl http2;
    server_name $DOM www.$DOM;
    root /var/www/clients/$USER/public_html;
    index index.php index.html;

    client_max_body_size 512M;

    ssl_certificate $CERT;
    ssl_certificate_key $KEY;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/www/clients/$USER/logs/access.log;
    error_log /var/www/clients/$USER/logs/error.log;

    location / { try_files \$uri \$uri/ /index.php?\$args; }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/$SOCK;
        fastcgi_param PHP_VALUE "memory_limit=\$limit";
    }
}
CONF
                # Inject memory limit placeholder if needed (handled below) -> actually better to just reload
            
            else
                # Generate Standard HTTP VHost
                cat > $VHOST <<CONF
server {
    listen 80;
    server_name $DOM www.$DOM;
    root /var/www/clients/$USER/public_html;
    index index.php index.html;

    client_max_body_size 512M;

    access_log /var/www/clients/$USER/logs/access.log;
    error_log /var/www/clients/$USER/logs/error.log;

    location / { try_files \$uri \$uri/ /index.php?\$args; }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/$SOCK;
    }
}
CONF
                # If SSL requested but no cert, run certbot
                if [ "$SSL" == "1" ]; then
                    certbot --nginx -d $DOM -d www.$DOM --non-interactive --agree-tos --email $ADMIN_EMAIL --redirect
                fi
            fi
            
            # Memory Limit update
            MEM=$(mysql -N -s -e "SELECT memory_limit FROM php_config WHERE domain_id=$3" $DB_NAME)
            if [ ! -z "$MEM" ]; then
                # Update pool config (simplified sed replace)
                POOL="/etc/php/$PHP_VER/fpm/pool.d/$USER.conf"
                if grep -q "php_admin_value\[memory_limit\]" $POOL; then
                    sed -i "s/php_admin_value\[memory_limit\].*/php_admin_value[memory_limit] = $MEM/" $POOL
                else
                    echo "php_admin_value[memory_limit] = $MEM" >> $POOL
                fi
                systemctl reload php$PHP_VER-fpm
            fi

            systemctl reload nginx
            log_action "Synced VHOST for $DOM (PHP $PHP_VER)"
        fi
        ;;

    # --------------------------------------------------------------------------
    # SERVICE CONTROL
    # --------------------------------------------------------------------------
    service-status)
        systemctl is-active $2
        ;;
        
    service-control)
        # $2: op, $3: service
        if [ "$3" == "php8.2-fpm" ] && [ "$2" == "reload" ]; then
            safe_reload_php
        else
            systemctl $2 $3
        fi
        ;;

    # --------------------------------------------------------------------------
    # APP INSTALLER TOOL
    # --------------------------------------------------------------------------
    app-tool)
        ACTION=$2
        APP=$3
        DOM=$4
        
        # Get User Info for Domain
        read USER PHP_VER <<< $(mysql -N -s -e "SELECT c.username, d.php_version FROM domains d JOIN clients c ON d.client_id=c.id WHERE d.domain='$DOM'" $DB_NAME)
        DOCROOT="/var/www/clients/$USER/public_html"
        TMP="/tmp/install_$USER"
        
        if [ "$ACTION" == "install" ]; then
            # $5: db_name, $6: db_user, $7: db_pass
            DB_NAME_VAL=$5
            DB_USER_VAL=$6
            DB_PASS=$7

            log_action "Starting App Install: $APP for $DOM ($USER)"
            
            # 1. Create Database & User
            $0 mysql-tool create-db $DB_NAME_VAL
            $0 mysql-tool create-user $DB_USER_VAL $DB_PASS $DB_NAME_VAL
            
            # 2. Update DB with 'active' status (Assume row exists)
            mysql -e "UPDATE app_installations SET status='active' WHERE db_name='$DB_NAME_VAL'" $DB_NAME

            mkdir -p $TMP

            if [ "$APP" == "wordpress" ]; then
                # WordPress Install
                wget https://wordpress.org/latest.tar.gz -O $TMP/wp.tar.gz
                tar -xzf $TMP/wp.tar.gz -C $TMP
                cp -r $TMP/wordpress/* $DOCROOT/
                
                # Config DB
                cp $DOCROOT/wp-config-sample.php $DOCROOT/wp-config.php
                sed -i "s/database_name_here/$DB_NAME_VAL/" $DOCROOT/wp-config.php
                sed -i "s/username_here/$DB_USER_VAL/" $DOCROOT/wp-config.php
                sed -i "s/password_here/$DB_PASS/" $DOCROOT/wp-config.php
                
                chown -R $USER:$USER $DOCROOT
                rm -rf $TMP
                log_action "Installed WordPress for $DOM"
                
            elif [ "$APP" == "laravel" ]; then
                # Laravel Install
                cd /var/www/clients/$USER
                rm -rf public_html_bak
                if [ -d "public_html" ]; then mv public_html public_html_bak; fi
                
                # Create Project
                sudo -u $USER composer create-project laravel/laravel public_html
                
                # Config DB (.env)
                sed -i "s/DB_DATABASE=laravel/DB_DATABASE=$DB_NAME_VAL/" $DOCROOT/.env
                sed -i "s/DB_USERNAME=root/DB_USERNAME=$DB_USER_VAL/" $DOCROOT/.env
                sed -i "s/DB_PASSWORD=/DB_PASSWORD=$DB_PASS/" $DOCROOT/.env
                
                chmod -R 775 $DOCROOT/storage $DOCROOT/bootstrap/cache
                
                # Update Nginx
                sed -i "s|root /var/www/clients/$USER/public_html;|root /var/www/clients/$USER/public_html/public;|" /etc/nginx/sites-available/$DOM
                systemctl reload nginx
                log_action "Installed Laravel for $DOM"
    
            elif [ "$APP" == "codeigniter" ]; then
                # CI4 Install
                wget https://github.com/codeigniter4/framework/archive/refs/tags/v4.4.4.zip -O $TMP/ci.zip
                unzip -q $TMP/ci.zip -d $TMP
                cp -r $TMP/framework-4.4.4/* $DOCROOT/
                
                # Config DB (.env)
                cp $DOCROOT/env $DOCROOT/.env
                sed -i "s/# database.default.database = ci4/database.default.database = $DB_NAME_VAL/" $DOCROOT/.env
                sed -i "s/# database.default.username = root/database.default.username = $DB_USER_VAL/" $DOCROOT/.env
                sed -i "s/# database.default.password = root/database.default.password = $DB_PASS/" $DOCROOT/.env
                sed -i "s/# CI_ENVIRONMENT = production/CI_ENVIRONMENT = development/" $DOCROOT/.env
                
                chown -R $USER:$USER $DOCROOT
                
                # Update Nginx
                sed -i "s|root /var/www/clients/$USER/public_html;|root /var/www/clients/$USER/public_html/public;|" /etc/nginx/sites-available/$DOM
                systemctl reload nginx
                log_action "Installed CodeIgniter for $DOM"
    
            elif [ "$APP" == "react" ]; then
                # React (Vite)
                cd /var/www/clients/$USER
                rm -rf public_html_bak
                if [ -d "public_html" ]; then mv public_html public_html_bak; fi
                mkdir public_html
                
                sudo -u $USER npm create vite@latest public_html -- --template react
                cd public_html
                sudo -u $USER npm install
                sudo -u $USER npm run build
                
                # Update Nginx
                sed -i "s|root /var/www/clients/$USER/public_html;|root /var/www/clients/$USER/public_html/dist;|" /etc/nginx/sites-available/$DOM
                systemctl reload nginx
                log_action "Installed React for $DOM"
            fi
            
        elif [ "$ACTION" == "uninstall" ]; then
            # $5: db_name, $6: db_user
            DB_NAME_VAL=$5
            DB_USER_VAL=$6
            
            log_action "Uninstalling App: $APP from $DOM ($USER)"
            
            # 1. Drop DB & User
            $0 mysql-tool delete-db $DB_NAME_VAL
            $0 mysql-tool delete-user $DB_USER_VAL
            
            # 2. Remove Files (Preserve public_html directory but empty it)
            # CAUTION: We don't want to delete the directory itself if it's the mount point or needed by nginx
            rm -rf $DOCROOT/*
            rm -rf $DOCROOT/.* 2>/dev/null # Remove hidden files like .env
            
            # 3. Restore Default Page
            echo "<h1>Welcome to $DOM</h1><p>Application Uninstalled.</p>" > $DOCROOT/index.html
            chown $USER:$USER $DOCROOT/index.html
            
            # 4. Reset Nginx Root if needed (Revert to public_html)
            # We blindly reset it to standard public_html just in case
            sed -i "s|root /var/www/clients/$USER/public_html/.*;|root /var/www/clients/$USER/public_html;|" /etc/nginx/sites-available/$DOM
            systemctl reload nginx
            
            log_action "Uninstallation Complete for $DOM"
        fi
        ;;

    # --------------------------------------------------------------------------
    # SSH KEY MANAGEMENT
    # --------------------------------------------------------------------------
    ssh-key)
        SUB=$2
        USER=$3
        
        SSH_DIR="/var/www/clients/$USER/.ssh"
        AUTH_FILE="$SSH_DIR/authorized_keys"
        
        if [ ! -d "$SSH_DIR" ]; then
            mkdir -p $SSH_DIR
            chmod 700 $SSH_DIR
            chown $USER:$USER $SSH_DIR
        fi
        
        if [ "$SUB" == "add" ]; then
            KEY=$4
            echo "$KEY" >> $AUTH_FILE
            chmod 600 $AUTH_FILE
            chown $USER:$USER $AUTH_FILE
            log_action "Added SSH Key for $USER"
            
        elif [ "$SUB" == "list" ]; then
            if [ -f "$AUTH_FILE" ]; then
                cat -n $AUTH_FILE
            fi
            
        elif [ "$SUB" == "delete" ]; then
            LINE=$4
            if [ -f "$AUTH_FILE" ]; then
                sed -i "${LINE}d" $AUTH_FILE
                log_action "Deleted SSH Key line $LINE for $USER"
            fi
        fi
        ;;

    # --------------------------------------------------------------------------
    # BACKUP SYSTEM
    # --------------------------------------------------------------------------
    backup)
        SUB=$2
        USER=$3
        BACKUP_DIR="/var/www/clients/$USER/backups"
        
        if [ ! -d "$BACKUP_DIR" ]; then
            mkdir -p $BACKUP_DIR
            chown $USER:$USER $BACKUP_DIR
        fi
        
        if [ "$SUB" == "create" ]; then
            TS=$(date +%Y%m%d_%H%M%S)
            FILE="$BACKUP_DIR/backup_$TS.tar.gz"
            
            # 1. Dump DBs
            CID=$(mysql -N -s -e "SELECT id FROM clients WHERE username='$USER'" $DB_NAME)
            mkdir -p /tmp/db_dump_$USER
            mysql -N -s -e "SELECT db_name FROM client_databases WHERE client_id=$CID" $DB_NAME | while read DB; do
                mysqldump $DB > /tmp/db_dump_$USER/$DB.sql
            done
            
            # 2. Tar Web + DBs
            tar -czf $FILE -C /var/www/clients/$USER public_html -C /tmp db_dump_$USER
            
            # Cleanup
            rm -rf /tmp/db_dump_$USER
            chown $USER:$USER $FILE
            
            log_action "Created Backup for $USER: $FILE"
            
        elif [ "$SUB" == "list" ]; then
            ls -lh $BACKUP_DIR | awk '{print $9, $5, $6, $7, $8}'
            
        elif [ "$SUB" == "restore" ]; then
            FILE="$BACKUP_DIR/$4"
            if [ -f "$FILE" ]; then
                # Extract
                tar -xzf $FILE -C /var/www/clients/$USER
                
                # Restore DBs
                if [ -d "/var/www/clients/$USER/db_dump_$USER" ]; then
                    for sql in /var/www/clients/$USER/db_dump_$USER/*.sql; do
                        DB=$(basename $sql .sql)
                        mysql $DB < $sql
                    done
                    rm -rf /var/www/clients/$USER/db_dump_$USER
                fi
                
                log_action "Restored Backup for $USER: $4"
            fi
        fi
        ;;

    # --------------------------------------------------------------------------
    # LOG VIEWER (Security)
    # --------------------------------------------------------------------------
    get-logs)
        TYPE=$2
        LINES=${3:-50}
        
        if [ "$TYPE" == "auth" ]; then
            tail -n $LINES /var/log/auth.log
        elif [ "$TYPE" == "web" ]; then
            tail -n $LINES /var/log/nginx/error.log
        elif [ "$TYPE" == "sys" ]; then
            tail -n $LINES /var/log/syslog
        fi
        ;;

    get-stats)
        CPU=$(top -bn1 | grep "Cpu(s)" | awk '{print 100 - $8}')
        RAM=$(free -m | awk '/Mem:/ {print int($3/$2 * 100)}')
        DISK=$(df -h / | awk 'NR==2 {print $5}' | sed 's/%//')
        UPTIME=$(uptime -p | sed 's/up //')
        echo "$CPU|$RAM|$DISK|$UPTIME"
        ;;

esac
